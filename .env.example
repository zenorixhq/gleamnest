# Database Connection
# SQLite by default for zero-setup local dev; use postgresql://... or mysql://... for cloud production
DATABASE_URL="file:./dev.db"

# Razorpay Payment Gateway Configuration (Optional - WhatsApp checkout works without this)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
